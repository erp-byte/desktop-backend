@startuml
title System Overview - All Modules

skinparam entity {
  BackgroundColor #F0F4FF
  BorderColor #3A5A8C
  HeaderBackgroundColor #3A5A8C
  FontColor white
  FontSize 11
  AttributeFontColor black
  AttributeFontSize 10
}
skinparam ArrowColor #3A5A8C
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #E6A817
skinparam shadowing false

entity "Sales Order" as SOH {
  * so_id
  --
  so_number
  customer_name
  company
  status
}

entity "SO Line" as SOL {
  * so_line_id
  --
  product_name
  quantity
  status
}

entity "SO Fulfillment" as SF {
  * fulfillment_id
  --
  product_name
  pending_qty_kg
  produced_qty_kg
  dispatched_qty_kg
  order_status
}

entity "Production Plan" as PP {
  * plan_id
  --
  plan_name
  plan_type
  plan_date
  status
}

entity "Plan Line" as PPL {
  * plan_line_id
  --
  product_name
  planned_qty_kg
  machine
  shift
}

entity "Bill of Materials" as BOM {
  * bom_id
  --
  product_name
  customer_name
  pack_size_kg
}

entity "Machine" as MACH {
  * machine_id
  --
  machine_name
  floor
  factory
  status
}

entity "Production Order" as PO {
  * prod_order_id
  --
  order_number
  batch_number
  product_name
  status
}

entity "Job Card" as JC {
  * job_card_id
  --
  job_number
  stage
  team_leader
  status
}

entity "Floor Inventory" as FI {
  * inventory_id
  --
  product_name
  floor_location
  quantity_kg
}

entity "Inventory Batch" as IB {
  * batch_id
  --
  product_name
  inward_date
  quantity_kg
  status
}

entity "Purchase Order" as POH {
  * transaction_no
  --
  vendor_name
  warehouse
  status
}

entity "Purchase Indent" as PI {
  * indent_id
  --
  material_name
  required_qty_kg
  status
}

entity "User" as USR {
  * user_id
  --
  full_name
  role
  is_active
}

SOH  ||--o{ SOL  : "has lines"
SOL  ||--o{ SF   : "fulfillment"
SOH  ||--o{ SF   : "parent SO"
PP   ||--o{ PPL  : "has lines"
PPL  }o--|| BOM  : "uses BOM"
PPL  }o--|| MACH : "on machine"
PPL  ||--o{ PO   : "generates order"
PO   }o--|| BOM  : "BOM locked"
PO   ||--o{ JC   : "has job cards"
JC   }o--|| MACH : "runs on"
PPL  ||--o{ PI   : "triggers indent"
POH  ||--o{ IB   : "source PO"
SOH  ||--o{ IB   : "blocked for SO"

note right of PP
  AI-assisted planning.
  Draft -> Approved -> Executed.
end note

note right of IB
  Batch-level inventory.
  FIFO-managed. Blockable for specific SO.
end note

@enduml
