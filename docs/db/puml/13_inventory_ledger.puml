@startuml
title Inventory Batch Ledger

skinparam entity {
  BackgroundColor #F0F4FF
  BorderColor #3A5A8C
  HeaderBackgroundColor #3A5A8C
  FontColor white
  FontSize 11
  AttributeFontColor black
  AttributeFontSize 10
}
skinparam ArrowColor #3A5A8C
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #E6A817
skinparam shadowing false

entity "Purchase Order" as POH {
  * transaction_no
  --
  vendor_name
}

entity "Sales Order" as SOH {
  * so_id
  --
  so_number
  customer_name
}

entity "Inventory Batch" as IB {
  * batch_id
  --
  product_name
  item_type
  lot_number
  source
  inward_date
  manufacturing_date
  expiry_date
  original_qty_kg
  current_qty_kg
  warehouse
  floor
  blocked_for_SO
  status
}

entity "Inventory Event Log" as IEL {
  * event_id
  --
  event_type
  from_status
  to_status
  from_location
  to_location
  quantity_kg
  reference_type
  performed_by
  notes
}

entity "Block History" as BBH {
  * id
  --
  action
  blocked_for_SO
  blocked_by
  override_note
}

entity "Internal Issue Note" as IIN {
  * note_id
  --
  note_number
  product_name
  quantity_kg
  source_warehouse
  destination_floor
  purpose
  requested_by
  approved_by
  status
}

POH  ||--o{ IB   : "source PO"
SOH  ||--o{ IB   : "reserved for SO"
IB   ||--o{ IEL  : "event history"
IB   ||--o{ BBH  : "block / unblock history"
IB   ||--o{ IIN  : "internal transfers"

note right of IB
  source: inward | stock take | production | return
  status: available | blocked | issued | in transit
    | internal hold | flagged
  FIFO ordering by inward_date.
  BLOCKED = reserved for a specific SO.
  FLAGGED = quality concern, skipped in FIFO allocation.
end note

note right of IEL
  Append-only audit trail - never modified or deleted.
  event_type: created | moved | blocked | unblocked
    | issued | returned | flagged | adjusted | override
end note

note right of IIN
  Internal transfers between warehouse and production floor.
  Requires approval before execution.
  purpose: sorting | grading | reprocessing | QC | other
end note

@enduml
